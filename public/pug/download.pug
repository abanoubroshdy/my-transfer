doctype html
html(lang='en')
  head
    include partials/head
    include partials/head_custom
  body
    .container
      .row(style='margin-bottom: 20px;')
        .col-xs-12
          img(src='img/logo.svg' alt='QVI Transfer' style='height: 52px; vertical-align: middle;')

      .row
        .col-md-5.col-lg-4
          #download
        .col-md-7.col-lg-8
          if adSense && adSense.enabled
            .adsense-card
              script(async src='https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js')
              ins.adsbygoogle(
                style='display:block; width:100%; height:100%;'
                data-ad-client=adSense.client
                data-ad-slot=adSense.sidebarSlot
                data-ad-format='auto'
                data-full-width-responsive='true'
              )
              script (adsbygoogle = window.adsbygoogle || []).push({});
          else
            .adsense-card(style='border: 2px dashed #cbd5e0; background: #ffffff; color: #a0aec0; border-radius: 24px;')
              h3(style='margin-top: 0; color: #718096;') [Google AdSense Advertisement Banner]
              p(style='font-size: 16px;') This area displays configurable Google AdSense ads on the right side of the transfer interface.
    include partials/footer
    script(src='app/common.js')
    script(src='app/download.js')
